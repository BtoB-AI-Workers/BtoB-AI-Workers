# Slack (Phase 0で取得)
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=...
SLACK_APP_TOKEN=xapp-...
CLAUDE_BOT_USER_ID=U...
ZAPIER_WEBHOOK_BOT_USER_ID=U...

# Channels (Phase 0で取得)
MAIN_CHANNEL_ID=C...
AUDIT_CHANNEL_ID=C...

# Anthropic (Haiku前段+Claude Code両方で使用)
ANTHROPIC_API_KEY=sk-ant-...

# Google (既存 GOOGLE_APPLICATION_CREDENTIALS 流用)
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service_account.json
SHEETS_ID=...

# SQLite (ローカル耐久ストア)
QUEUE_DB_PATH=~/.local/share/line-slack-agent/queue.db
DEDUPE_LEDGER_PATH=~/.local/share/line-slack-agent/dedupe_ledger.db

# Agent mode
# dry_run: 送信を全停止してDMドラフトのみ
# production: 本番送信
AGENT_MODE=dry_run

# Knowledge（パターンA: Drive→GitHub片方向同期）
# source of truth (業務担当が編集)
KNOWLEDGE_DRIVE_MOUNT=C:\Users\hi200\Google ドライブ ストリーミング\マイドライブ\BtoB-AI-Workers-Knowledge
# GitHub repo ローカルclone内のミラーパス（エージェントはこちらを読む）
KNOWLEDGE_GITHUB_REPO_PATH=/absolute/path/to/local/clone/knowledge
# sync Bot動作間隔（秒）
KNOWLEDGE_SYNC_INTERVAL_SEC=600

# Claude Code sandbox
CLAUDE_SANDBOX_DIR=/absolute/path/to/line-slack-agent/sandbox
